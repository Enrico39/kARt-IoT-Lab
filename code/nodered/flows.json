    {
        "id": "fn0020kart",
        "type": "function",
        "z": "tab0001kart",
        "name": "Stato kARt",
        "func": "// Unisce telemetria, stato dei nodi e metriche del Quest in un unico oggetto per la dashboard\nconst s = flow.get('stato') || { kartOnline: false, questOnline: false };\nconst p = msg.payload;\nswitch (msg.topic) {\n    case 'arkart/kart/telemetry':\n        Object.assign(s, p);\n        s.lastTelemetry = Date.now();\n        s.kartOnline = true;\n        break;\n    case 'arkart/kart/status':\n        s.kartOnline = String(p) === 'online';\n        break;\n    case 'arkart/quest/status':\n        s.questOnline = String(p) === 'online';\n        break;\n    case 'arkart/quest/metrics':\n        s.quest = p;\n        s.questOnline = true;\n        break;\n}\nflow.set('stato', s);\nreturn { payload: Object.assign({}, s) };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 160,
        "wires": [
            [
                "tpl0024kart",
                "tpl0025kart",
                "tpl0026kart",
                "tpl0027kart",
                "tpl0051kart"
            ]
        ]
    },
    {
        "id": "fn0021kart",
        "type": "function",
        "z": "tab0001kart",
        "name": "Valori per i grafici",
        "func": "// Distanza posteriore limitata a 100 cm: oltre, e quando il sensore non vede niente (-1),\n// si disegna 100, così la linea resta continua invece di avere buchi.\n// Con la distanza si inviano le due soglie (frenata e rallentamento) come linee orizzontali.\nconst p = msg.payload;\nconst LIMITE = 100;\nlet distanza = null;\nif (typeof p.rear_distance_cm === 'number') {\n    const d = p.rear_distance_cm < 0 ? LIMITE : Math.min(p.rear_distance_cm, LIMITE);\n    const stop = (flow.get('config') || {}).stop || 15;\n    distanza = [\n        { topic: 'Distanza (cm)', payload: d },\n        { topic: 'Frenata', payload: stop },\n        { topic: 'Rallenta', payload: 30 },\n    ];\n}\nconst wifi = typeof p.rssi_dbm === 'number' ? { topic: 'Wi-Fi (dBm)', payload: p.rssi_dbm } : null;\nreturn [distanza, wifi];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 260,
        "wires": [
            [
                "cht0028kart"
            ],
            [
                "cht0029kart"
            ]
        ]
    },
    {
        "id": "fn0022kart",
        "type": "function",
        "z": "tab0001kart",
        "name": "Registro eventi",
        "func": "// Tiene gli ultimi 30 eventi e i contatori per tipo\nconst lista = flow.get('eventi') || [];\nconst contatori = flow.get('contatori') || {};\nconst e = msg.payload || {};\nconst titoli = { COLLISION_PREVENTED: 'Frenata automatica', FAILSAFE: 'Fail-safe' };\nlista.unshift({\n    ora: new Date(e.ts || Date.now()).toLocaleTimeString('it-IT'),\n    tipo: e.event,\n    titolo: titoli[e.event] || e.event,\n    dettaglio: e.distance_cm != null ? 'ostacolo a ' + e.distance_cm + ' cm' : 'comandi interrotti, motori fermi'\n});\nlista.length = Math.min(lista.length, 30);\ncontatori[e.event] = (contatori[e.event] || 0) + 1;\nflow.set('eventi', lista);\nflow.set('contatori', contatori);\nreturn { payload: { lista: lista, contatori: contatori, nuovo: e.event } };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 340,
        "wires": [
            [
                "tpl0030kart"
            ]
        ]
    },
    {
        "id": "cmt0023kart",
        "type": "comment",
        "z": "tab0001kart",
