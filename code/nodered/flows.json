        "format": "<template>\n  <div class=\"kt kt-tile\">\n    <div class=\"kt-row\"><span>Temperatura CPU</span><span :class=\"classeTemp\">{{ s.cpu_temp_c != null ? s.cpu_temp_c.toFixed(1) + ' °C' : '—' }}</span></div>\n    <div class=\"kt-row\"><span>Segnale Wi-Fi</span><span>{{ s.rssi_dbm != null ? s.rssi_dbm + ' dBm' : '—' }} <span class=\"kt-label\">{{ qualita }}</span></span></div>\n    <div class=\"kt-row\"><span>Acceso da</span><span>{{ uptime }}</span></div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data () { return { s: {}, ora: Date.now() } },\n  mounted () { this.timer = setInterval(() => { this.ora = Date.now() }, 1000) },\n  unmounted () { clearInterval(this.timer) },\n  watch: { msg: function () { if (this.msg && this.msg.payload) this.s = this.msg.payload } },\n  methods: {\n    fa (t) {\n      if (!t) return 'mai'\n      const sec = Math.round((this.ora - t) / 1000)\n      return sec < 2 ? 'adesso' : sec < 60 ? sec + ' s fa' : Math.floor(sec / 60) + ' min fa'\n    },\n    stantio () { return !this.s.lastTelemetry || this.ora - this.s.lastTelemetry > 5000 },\n    barra (v, max, colore) {\n      const f = Math.max(-1, Math.min(1, (v || 0) / max))\n      const left = f >= 0 ? 50 : 50 + f * 50\n      return { left: left + '%', width: Math.abs(f) * 50 + '%', background: colore }\n    }\n  },\n  computed: {\n    classeTemp () { const t = this.s.cpu_temp_c; return t == null ? 'kt-muted' : t > 75 ? 'kt-bad' : t > 65 ? 'kt-warn' : '' },\n    qualita () {\n      const r = this.s.rssi_dbm\n      if (r == null) return ''\n      return r > -55 ? 'ottimo' : r > -67 ? 'buono' : r > -75 ? 'debole' : 'scarso'\n    },\n    uptime () {\n      const u = this.s.uptime_s\n      if (u == null) return '—'\n      const h = Math.floor(u / 3600), m = Math.floor(u % 3600 / 60), sec = u % 60\n      return h > 0 ? h + ' h ' + m + ' min' : m > 0 ? m + ' min ' + sec + ' s' : sec + ' s'\n    }\n  }\n}\n</script>",
