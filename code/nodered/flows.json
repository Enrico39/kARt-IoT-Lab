        "format": ".kt { color: #d7dae0; font-variant-numeric: tabular-nums; font-size: 14px; }\n.kt-label { font-size: 12px; color: #8a9099; }\n.kt-big { font-size: 38px; font-weight: 600; line-height: 1.15; letter-spacing: -0.02em; }\n.kt-unit { font-size: 15px; font-weight: 400; color: #8a9099; margin-left: 4px; }\n.kt-code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; color: #6b717a;\n           border: 1px solid #2a2d33; border-radius: 3px; padding: 1px 5px; margin-left: 6px; vertical-align: middle; }\n.kt-row { display: flex; justify-content: space-between; align-items: baseline; padding: 7px 0; border-top: 1px solid #25282d; }\n.kt-row:first-of-type { border-top: 0; }\n.kt-row > span:first-child { color: #8a9099; }\n.kt-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 7px; vertical-align: 1px; }\n.kt-ok { color: #6fbf8a; } .kt-warn { color: #e3a93b; } .kt-bad { color: #e3635a; } .kt-muted { color: #6b717a; }\n.kt-seg { display: flex; gap: 4px; margin: 12px 0 6px; }\n.kt-seg span { flex: 1; height: 10px; border-radius: 2px; background: #2a2d33; transition: background .2s; }\n.kt-bar { position: relative; height: 6px; background: #2a2d33; border-radius: 3px; margin: 6px 0 12px; }\n.kt-bar i { position: absolute; top: 0; bottom: 0; border-radius: 3px; transition: left .15s, width .15s; }\n.kt-bar b { position: absolute; left: 50%; top: -3px; bottom: -3px; width: 1px; background: #5a5f68; }\n.kt-ev { display: grid; grid-template-columns: 70px 1fr auto; gap: 10px; padding: 7px 0; border-top: 1px solid #25282d; align-items: baseline; }\n.kt-ev:first-of-type { border-top: 0; }\n.kt-ev time { color: #6b717a; }\n.kt-tile { min-height: 150px; display: flex; flex-direction: column; }\n.kt-tile .kt-big { font-size: 30px; }\n.kt-evlist { height: 232px; overflow-y: auto; }\n.kt-ev.stretto { grid-template-columns: 62px 1fr; }\n.kt-btn { background: none; border: 1px solid #2a2d33; color: #8a9099; border-radius: 4px; padding: 2px 8px; font-size: 12px; cursor: pointer; }\n.kt-btn.on { color: #f2c200; border-color: #f2c200; }",
