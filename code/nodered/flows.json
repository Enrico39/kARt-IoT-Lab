    {
        "id": "fn0048kart",
        "type": "function",
        "z": "tab0002kart",
        "name": "Kart simulato",
        "func": "// Ciclo di 40 s: guida avanti, retromarcia verso un muro (WARN → STOP), pausa senza comandi (FAILSAFE)\nconst t = (Date.now() / 1000) % 40;\nconst out = [];\nif (!context.get('avviato')) {\n    context.set('avviato', true);\n    out.push({ topic: 'arkart/kart/status', payload: 'online' });\n    out.push({ topic: 'arkart/quest/status', payload: 'online' });\n}\nlet state = 'OK', throttle = 0, steer = 0, pan = 0, dist = -1;\nif (t < 14) { throttle = 150 + Math.round(60 * Math.sin(t)); steer = Math.round(120 * Math.sin(t / 2)); pan = Math.round(30 * Math.sin(t / 3)); }\nelse if (t < 26) { throttle = -140; dist = Math.max(9, Math.round(70 - (t - 14) * 6)); state = dist < 15 ? 'STOP' : dist < 30 ? 'WARN' : 'OK'; }\nelse if (t < 32) { state = 'FAILSAFE'; dist = 40; }\nconst prev = context.get('prev');\nif (state !== prev) {\n    if (state === 'STOP') out.push({ topic: 'arkart/kart/events', payload: { event: 'COLLISION_PREVENTED', distance_cm: dist, ts: Date.now() } });\n    if (state === 'FAILSAFE') out.push({ topic: 'arkart/kart/events', payload: { event: 'FAILSAFE', ts: Date.now() } });\n    context.set('prev', state);\n}\nout.push({ topic: 'arkart/kart/telemetry', payload: {\n    rear_distance_cm: dist, throttle: throttle, steer: steer, pan: pan, state: state,\n    rssi_dbm: -58 + Math.round(4 * Math.sin(t / 5)), cpu_temp_c: 47.3 + Math.round(10 * Math.sin(t / 20)) / 10,\n    uptime_s: Math.floor(Date.now() / 1000) % 100000 } });\nout.push({ topic: 'arkart/quest/metrics', payload: { rtt_ms: 38 + Math.round(20 * Math.random()), video_fps: 27 + Math.round(Math.random() * 2), lost_pkts: 3 } });\nnode.send([out]);\nreturn null;",
