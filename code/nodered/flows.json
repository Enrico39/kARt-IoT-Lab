    {
        "id": "tpl0024kart",
        "type": "ui-template",
        "z": "tab0001kart",
        "group": "grp0007kart",
        "page": "",
        "ui": "",
        "name": "Kart",
        "order": 1,
        "width": "0",
        "height": "0",
        "head": "",
        "format": "<template>\n  <div class=\"kt kt-tile\">\n    <div class=\"kt-big\" :class=\"classe\">{{ titolo }}</div>\n    <div class=\"kt-label\" style=\"margin: 2px 0 8px\">{{ descrizione }}</div>\n    <div class=\"kt-row\"><span>Kart</span><span><i class=\"kt-dot\" :style=\"{ background: s.kartOnline ? '#6fbf8a' : '#e3635a' }\"></i>{{ s.kartOnline ? 'online' : 'offline' }}</span></div>\n    <div class=\"kt-row\"><span>Quest</span><span><i class=\"kt-dot\" :style=\"{ background: s.questOnline ? '#6fbf8a' : '#5a5f68' }\"></i>{{ s.questOnline ? 'online' : 'non collegato' }}</span></div>\n    <div class=\"kt-row\"><span>Ultimo dato</span><span :class=\"stantio() ? 'kt-bad' : ''\">{{ fa(s.lastTelemetry) }}</span></div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data () { return { s: {}, ora: Date.now() } },\n  mounted () { this.timer = setInterval(() => { this.ora = Date.now() }, 1000) },\n  unmounted () { clearInterval(this.timer) },\n  watch: { msg: function () { if (this.msg && this.msg.payload) this.s = this.msg.payload } },\n  methods: {\n    fa (t) {\n      if (!t) return 'mai'\n      const sec = Math.round((this.ora - t) / 1000)\n      return sec < 2 ? 'adesso' : sec < 60 ? sec + ' s fa' : Math.floor(sec / 60) + ' min fa'\n    },\n    stantio () { return !this.s.lastTelemetry || this.ora - this.s.lastTelemetry > 5000 },\n    barra (v, max, colore) {\n      const f = Math.max(-1, Math.min(1, (v || 0) / max))\n      const left = f >= 0 ? 50 : 50 + f * 50\n      return { left: left + '%', width: Math.abs(f) * 50 + '%', background: colore }\n    }\n  },\n  computed: {\n    titolo () {\n      if (this.stantio()) return 'Nessun dato'\n      return { OK: 'Pronto', WARN: 'Ostacolo vicino', STOP: 'Frenata', FAILSAFE: 'In sicurezza',\n               BOOT: 'Avvio', DISCONNECTED: 'Arduino scollegato' }[this.s.state] || this.s.state\n    },\n    descrizione () {\n      if (this.stantio()) return 'la Pi non pubblica telemetria'\n      return { OK: 'comandi ricevuti, nessun ostacolo dietro',\n               WARN: 'retromarcia rallentata dal sensore',\n               STOP: 'retromarcia bloccata: ostacolo troppo vicino',\n               FAILSAFE: 'nessun comando dal pilota: motori fermi',\n               BOOT: 'firmware in avvio',\n               DISCONNECTED: 'la Pi non vede l\\'Arduino sulla USB' }[this.s.state] || ''\n    },\n    classe () {\n      if (this.stantio()) return 'kt-muted'\n      return { OK: 'kt-ok', WARN: 'kt-warn', STOP: 'kt-bad', FAILSAFE: 'kt-bad' }[this.s.state] || 'kt-muted'\n    }\n  }\n}\n</script>",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 920,
        "y": 140,
        "wires": [
            []
        ]
    },
    {
        "id": "tpl0025kart",
        "type": "ui-template",
        "z": "tab0001kart",
        "group": "grp0008kart",
        "page": "",
        "ui": "",
        "name": "Sensore posteriore",
        "order": 1,
        "width": "0",
        "height": "0",
        "head": "",
        "format": "<template>\n  <div class=\"kt kt-tile\">\n    <div class=\"kt-label\">Distanza dall'ostacolo</div>\n    <div class=\"kt-big\" :class=\"classe\">\n      <template v-if=\"libero\">libero</template>\n      <template v-else>{{ s.rear_distance_cm }}<span class=\"kt-unit\">cm</span></template>\n    </div>\n    <div class=\"kt-seg\"><span v-for=\"(c, i) in colori\" :key=\"i\" :style=\"{ background: c }\"></span></div>\n    <div class=\"kt-label\">rallenta sotto 30 cm · frena sotto {{ s.stop_cm || 15 }} cm</div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data () { return { s: {}, ora: Date.now() } },\n  mounted () { this.timer = setInterval(() => { this.ora = Date.now() }, 1000) },\n  unmounted () { clearInterval(this.timer) },\n  watch: { msg: function () { if (this.msg && this.msg.payload) this.s = this.msg.payload } },\n  methods: {\n    fa (t) {\n      if (!t) return 'mai'\n      const sec = Math.round((this.ora - t) / 1000)\n      return sec < 2 ? 'adesso' : sec < 60 ? sec + ' s fa' : Math.floor(sec / 60) + ' min fa'\n    },\n    stantio () { return !this.s.lastTelemetry || this.ora - this.s.lastTelemetry > 5000 },\n    barra (v, max, colore) {\n      const f = Math.max(-1, Math.min(1, (v || 0) / max))\n      const left = f >= 0 ? 50 : 50 + f * 50\n      return { left: left + '%', width: Math.abs(f) * 50 + '%', background: colore }\n    }\n  },\n  computed: {\n    libero () { return this.stantio() || this.s.rear_distance_cm == null || this.s.rear_distance_cm < 0 },\n    accesi () {\n      if (this.libero) return 0\n      const d = this.s.rear_distance_cm, portata = 60, stop = this.s.stop_cm || 15\n      if (d >= portata) return 0\n      return Math.max(1, Math.min(8, Math.ceil((portata - d) / (portata - stop) * 8)))\n    },\n    classe () {\n      if (this.libero) return 'kt-muted'\n      const d = this.s.rear_distance_cm\n      return d < (this.s.stop_cm || 15) ? 'kt-bad' : d < 30 ? 'kt-warn' : ''\n    },\n    colori () {\n      const lista = []\n      for (let i = 1; i <= 8; i++) {\n        lista.push(i > this.accesi ? '#2a2d33' : i <= 3 ? '#6fbf8a' : i <= 6 ? '#e3a93b' : '#e3635a')\n      }\n      return lista\n    }\n  }\n}\n</script>",
        "storeOutMessages": true,
