        "format": "<template>\n  <div class=\"kt\">\n    <div class=\"kt-row\" style=\"border:0\"><span>Acceleratore</span><span>{{ perc(s.throttle) }}</span></div>\n    <div class=\"kt-bar\"><b></b><i :style=\"barra(s.throttle, 255, (s.throttle || 0) >= 0 ? '#6fbf8a' : '#e3a93b')\"></i></div>\n    <div class=\"kt-row\" style=\"border:0\"><span>Sterzo</span><span>{{ lato(s.steer, 255, '%') }}</span></div>\n    <div class=\"kt-bar\"><b></b><i :style=\"barra(s.steer, 255, '#7fa7d9')\"></i></div>\n    <div class=\"kt-row\" style=\"border:0\"><span>Camera</span><span>{{ lato(s.pan, 1, '°') }}</span></div>\n    <div class=\"kt-bar\"><b></b><i :style=\"barra(s.pan, 45, '#d7dae0')\"></i></div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data () { return { s: {}, ora: Date.now() } },\n  mounted () { this.timer = setInterval(() => { this.ora = Date.now() }, 1000) },\n  unmounted () { clearInterval(this.timer) },\n  watch: { msg: function () { if (this.msg && this.msg.payload) this.s = this.msg.payload } },\n  methods: {\n    fa (t) {\n      if (!t) return 'mai'\n      const sec = Math.round((this.ora - t) / 1000)\n      return sec < 2 ? 'adesso' : sec < 60 ? sec + ' s fa' : Math.floor(sec / 60) + ' min fa'\n    },\n    stantio () { return !this.s.lastTelemetry || this.ora - this.s.lastTelemetry > 5000 },\n    barra (v, max, colore) {\n      const f = Math.max(-1, Math.min(1, (v || 0) / max))\n      const left = f >= 0 ? 50 : 50 + f * 50\n      return { left: left + '%', width: Math.abs(f) * 50 + '%', background: colore }\n    }\n  },\n  computed: {\n    perc () { return (v) => (v == null ? '—' : Math.round(v / 2.55) + '%') },\n    lato () {\n      return (v, scala, unita) => {\n        if (v == null) return '—'\n        const x = Math.round(Math.abs(v) / (unita === '%' ? 2.55 : scala))\n        return v === 0 ? 'centro' : (v < 0 ? 'sx ' : 'dx ') + x + unita\n      }\n    }\n  }\n}\n</script>",
