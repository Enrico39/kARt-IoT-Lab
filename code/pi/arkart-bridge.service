[Unit]
Description=kARt bridge UDP <-> seriale <-> MQTT
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=__UTENTE__
ExecStart=/usr/bin/python3 __DIR__/arkart_bridge.py
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
